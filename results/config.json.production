{
  "sourceDatabase": {
    "host": "SOURCE_DB_HOST",
    "port": 5432,
    "db": "source_database_name",
    "schema": "videoanalytics",
    "user": "source_user",
    "password": "source_password"
  },
  "sequenceDatabase": {
    "host": "SEQUENCE_DB_HOST",
    "port": 5432,
    "db": "sequences_database_name",
    "schema": "public",
    "user": "sequence_user",
    "password": "sequence_password"
  },
  "rootDatabase": {
    "host": "SEQUENCE_DB_HOST",
    "port": 5432,
    "user": "postgres_root_user",
    "password": "postgres_root_password",
    "maintenanceDb": "postgres"
  },
  "sourceTable": {
    "table": "alpr_detections",
    "loadFrom": "2026-03-16T00:00:00"
  },
  "reports": {
    "outputDirectory": "C:/Users/vkazymyrovych/Desktop/reports"
  },
  "messaging": {
    "enabled": false,
    "telegramBotToken": "BOT_TOKEN_IF_ENABLED",
    "telegramChatId": "CHAT_ID_IF_ENABLED"
  },
  "sequenceCloseTimeoutMinutes": 2880,
  "allowTransitionalAfterSingleCamera": false,
  "duplicateSuppressionSeconds": 2,
  "notifications": [
    {
      "cameraId": 14,
      "delaySeconds": 900,
      "message": "No Drive in (out) within 15 minutes"
    },
    {
      "cameraId": 25,
      "delaySeconds": 900,
      "message": "No Drive in (out) within 15 minutes"
    },
    {
      "cameraId": 19,
      "delaySeconds": 900,
      "message": "No Post in within 15 minutes"
    },
    {
      "cameraId": 22,
      "directionRange": {
        "from": 130,
        "to": 310
      },
      "delaySeconds": 900,
      "message": "No Post in within 15 minutes"
    }
  ],
  "realStages": [
    {
      "name": "drive_in",
      "label": "Drive In",
      "inTriggers": [
        {
          "cameraId": 14
        },
        {
          "cameraId": 25
        }
      ],
      "outTriggers": [
        {
          "cameraId": 16
        }
      ]
    },
    {
      "name": "service",
      "label": "Service",
      "inTriggers": [
        {
          "cameraId": 19
        },
        {
          "cameraId": 22,
          "directionRange": {
            "from": 130,
            "to": 310
          }
        }
      ],
      "outTriggers": [
        {
          "cameraId": 22,
          "directionRange": {
            "from": 310,
            "to": 130
          }
        }
      ]
    },
    {
      "name": "parking",
      "label": "Parking",
      "inTriggers": [
        {
          "cameraId": 20,
          "directionRange": {
            "from": 270,
            "to": 90
          }
        }
      ],
      "outTriggers": [
        {
          "cameraId": 20,
          "directionRange": {
            "from": 90,
            "to": 270
          }
        }
      ]
    }
  ],
  "transitionalStages": [
    {
      "name": "backyard",
      "label": "Backyard",
      "triggerCameras": [17],
      "candidateTimeoutSeconds": 2,
      "allowedAfter": ["service", "parking"],
      "sequenceCloseTimeoutOverrideSeconds": 0,
      "showInReportIfIncomplete": false
    },
    {
      "name": "test_drive",
      "label": "Test-Drive",
      "triggerCameras": [16, 13],
      "candidateTimeoutSeconds": 300,
      "allowedAfter": ["drive_in"],
      "sequenceCloseTimeoutOverrideSeconds": 3600,
      "showInReportIfIncomplete": false
    }
  ],
  "singleCameraStages": [
    {
      "name": "post_1",
      "label": "Post 1",
      "cameraId": 23,
      "timeoutSeconds": 30
    },
    {
      "name": "post_2",
      "label": "Post 2",
      "cameraId": 24,
      "timeoutSeconds": 30
    }
  ]
}
