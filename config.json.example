{
  "sourceDatabase": {
    "host": "SOURCE_DB_HOST",
    "port": 5432,
    "db": "source_database_name",
    "schema": "videoanalytics",
    "user": "source_user",
    "password": "source_password"
  },
  "sequenceDatabase": {
    "host": "SEQUENCE_DB_HOST",
    "port": 5432,
    "db": "sequences_database_name",
    "schema": "public",
    "user": "sequence_user",
    "password": "sequence_password"
  },
  "rootDatabase": {
    "host": "SEQUENCE_DB_HOST",
    "port": 5432,
    "user": "postgres_root_user",
    "password": "postgres_root_password",
    "maintenanceDb": "postgres"
  },
  "sourceTable": {
    "table": "alpr_detections",
    "loadFrom": "2026-03-22T00:00:00"
  },
  "reports": {
    "outputDirectory": "./reports"
  },
  "messaging": {
    "enabled": false,
    "telegramBotToken": "BOT_TOKEN_IF_ENABLED",
    "telegramChatId": "CHAT_ID_IF_ENABLED"
  },
  "sequenceCloseTimeoutMinutes": 2880,
  "allowTransitionalAfterSingleCamera": false,
  "duplicateSuppressionSeconds": 2,
  "notifications": [
    {
      "cameraId": 1001,
      "directionRange": { "from": 0, "to": 180 },
      "delaySeconds": 900,
      "message": "Автомобіль довго стоїть на Drive-In"
    },
    {
      "cameraId": 1101,
      "delaySeconds": 1800,
      "message": "Автомобіль затримався на Post"
    }
  ],
  "realStages": [
    {
      "name": "drive_in",
      "label": "Drive In",
      "inTriggers": [
        { "cameraId": 1001, "directionRange": { "from": 0, "to": 180 } }
      ],
      "outTriggers": [
        { "cameraId": 1002, "directionRange": { "from": 180, "to": 360 } }
      ]
    },
    {
      "name": "service",
      "label": "Service",
      "inTriggers": [
        { "cameraId": 1003, "directionRange": { "from": 0, "to": 360 } }
      ],
      "outTriggers": [
        { "cameraId": 1005, "directionRange": { "from": 0, "to": 180 } },
        { "cameraId": 1005, "directionRange": { "from": 180, "to": 360 } }
      ]
    },
    {
      "name": "parking",
      "label": "Parking",
      "inTriggers": [
        { "cameraId": 1006 }
      ],
      "outTriggers": [
        { "cameraId": 1007 }
      ]
    }
  ],
  "transitionalStages": [
    {
      "name": "backyard",
      "label": "Backyard",
      "triggerCameras": [1008],
      "candidateTimeoutSeconds": 2,
      "allowedAfter": ["service", "drive_in"],
      "sequenceCloseTimeoutOverrideSeconds": 0,
      "showInReportIfIncomplete": false
    },
    {
      "name": "test_drive",
      "label": "Test-Drive",
      "triggerCameras": [1002, 1009],
      "candidateTimeoutSeconds": 1800,
      "allowedAfter": ["service", "parking"],
      "sequenceCloseTimeoutOverrideSeconds": 3600,
      "showInReportIfIncomplete": false
    }
  ],
  "singleCameraStages": [
    {
      "name": "post_1",
      "label": "Post 1",
      "cameraId": 1101,
      "timeoutSeconds": 30
    },
    {
      "name": "post_2",
      "label": "Post 2",
      "cameraId": 1102,
      "timeoutSeconds": 30
    }
  ]
}
