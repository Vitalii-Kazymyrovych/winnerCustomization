{
  "sourceDatabase": {
    "host": "SOURCE_DB_HOST",
    "port": 5432,
    "db": "source_database_name",
    "schema": "videoanalytics",
    "user": "source_user",
    "password": "source_password"
  },
  "sequenceDatabase": {
    "host": "SEQUENCE_DB_HOST",
    "port": 5432,
    "db": "sequences_database_name",
    "schema": "public",
    "user": "sequence_user",
    "password": "sequence_password"
  },
  "rootDatabase": {
    "host": "SEQUENCE_DB_HOST",
    "port": 5432,
    "user": "postgres_root_user",
    "password": "postgres_root_password",
    "maintenanceDb": "postgres"
  },
  "sourceTable": {
    "table": "alpr_detections",
    "loadFrom": "2026-03-22T00:00:00"
  },
  "reports": {
    "outputDirectory": "./reports"
  },
  "messaging": {
    "enabled": false,
    "telegramBotToken": "BOT_TOKEN_IF_ENABLED",
    "telegramChatId": "CHAT_ID_IF_ENABLED"
  },
  "sequenceCloseTimeoutMinutes": 2880,
  "sourceRefresh": {
    "enabled": true,
    "intervalSeconds": 30
  },
  "notifications": [
    {
      "cameraId": 1001,
      "directionRange": { "from": 0, "to": 180 },
      "delaySeconds": 900,
      "message": "No Drive in (out) within 15 minutes"
    },
    {
      "cameraId": 1101,
      "delaySeconds": 900,
      "message": "No Post in within 15 minutes"
    }
  ],
  "realStages": [
    {
      "name": "drive_in",
      "label": "Drive In",
      "inTriggers": [
        { "cameraId": 1001, "directionRange": { "from": 0, "to": 180 } }
      ],
      "outTriggers": [
        { "cameraId": 1002, "directionRange": { "from": 180, "to": 360 } }
      ]
    },
    {
      "name": "service",
      "label": "Service",
      "inTriggers": [
        { "cameraId": 1003 }
      ],
      "outTriggers": [
        { "cameraId": 1004 }
      ]
    }
  ],
  "transitionalStages": [
    {
      "name": "backyard",
      "label": "Backyard",
      "triggerCameras": [2001],
      "candidateTimeoutSeconds": 10,
      "allowedAfter": ["service", "post_1"],
      "sequenceCloseTimeoutOverrideSeconds": 0,
      "showInReportIfIncomplete": false
    },
    {
      "name": "test_drive",
      "label": "Test-Drive",
      "triggerCameras": [2002],
      "candidateTimeoutSeconds": 5,
      "allowedAfter": ["backyard"],
      "sequenceCloseTimeoutOverrideSeconds": 900,
      "showInReportIfIncomplete": true
    }
  ],
  "singleCameraStages": [
    {
      "name": "post_1",
      "label": "Post 1",
      "cameraId": 1101,
      "timeoutSeconds": 30
    }
  ]
}
